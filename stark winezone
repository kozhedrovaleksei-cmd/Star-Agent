      <button role="tab" aria-selected="false" data-view="signals">📈 Сигналы</button>
    </div>
  </div>
</header>

<main>
  <!-- GLOBE -->
  <section id="globe-view" class="view active" role="tabpanel">
    <div class="stage">
      <canvas id="globe" aria-label="Интерактивный глобус регионов вина и спиртов"></canvas>
      <div class="hero-copy">
        <h1 class="serif">Атлас <em>терруара</em></h1>
