<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>STARK · ВИНО &amp; СПИРТЫ — Атлас</title>
<meta name="description" content="STARK PROTOCOL — глобус терруаров, сигналы покупки/продажи, карта спроса и библиотека вина и крепкого алкоголя." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070a10;
    --bg2:#0b1018;
    --ink:#eef2f8;
    --muted:#9aa6b8;
    --faint:#5a6678;
    --line:rgba(255,255,255,.09);
    --glass:rgba(20,26,36,.62);
    --glass-strong:rgba(16,21,30,.86);
    --blue:#0a84ff;        /* STARK accent */
    --blue-ink:#5cb0ff;
    --bordeaux:#7a1f2b;    /* ambient subject accent */
    --acc:#0a84ff;
    --buy:#34c759;
    --hold:#5ac8fa;
    --watch:#ffb340;
    --avoid:#ff6b5e;
    --radius:18px;
    --radius-sm:12px;
    --shadow:0 24px 60px rgba(0,0,0,.5);
    --maxw:1180px;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:
      radial-gradient(1200px 700px at 78% -8%, rgba(122,31,43,.30), transparent 60%),
      radial-gradient(900px 600px at 8% 110%, rgba(10,132,255,.16), transparent 55%),
      var(--bg);
    color:var(--ink);
    font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  .serif{font-family:"Cormorant Garamond",Georgia,serif;}
  a{color:var(--blue-ink);text-decoration:none}

  /* Header */
  header{
    position:sticky;top:0;z-index:40;
    backdrop-filter:saturate(160%) blur(18px);
    -webkit-backdrop-filter:saturate(160%) blur(18px);
    background:linear-gradient(180deg, rgba(7,10,16,.92), rgba(7,10,16,.55));
    border-bottom:1px solid var(--line);
  }
  .bar{max-width:var(--maxw);margin:0 auto;padding:14px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .brand{display:flex;flex-direction:column;line-height:1}
  .brand .t{font-weight:700;letter-spacing:.14em;font-size:13px}
  .brand .t b{color:var(--blue-ink)}
  .brand .s{font-size:10px;letter-spacing:.34em;color:var(--faint);margin-top:5px}
  .seg{margin-left:auto;display:flex;gap:4px;background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:999px;padding:4px}
  .seg button{
    appearance:none;border:0;background:transparent;color:var(--muted);
    font:600 13px Inter;padding:8px 16px;border-radius:999px;cursor:pointer;transition:.18s;white-space:nowrap
  }
  .seg button:hover{color:var(--ink)}
  .seg button[aria-selected="true"]{background:var(--blue);color:#fff;box-shadow:0 6px 18px rgba(10,132,255,.35)}
  .seg button:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}

  main{max-width:var(--maxw);margin:0 auto;padding:0 20px 80px}
  .view{display:none}
  .view.active{display:block;animation:fade .5s ease both}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  /* ---------- GLOBE ---------- */
  .stage{position:relative;height:min(72vh,720px);margin-top:8px}
  #globe{position:absolute;inset:0;width:100%;height:100%;cursor:grab;border-radius:24px}
  #globe.grabbing{cursor:grabbing}
  .hero-copy{position:absolute;left:6px;top:10px;max-width:360px;pointer-events:none;z-index:3}
  .hero-copy h1{font-size:clamp(30px,5vw,54px);font-weight:600;margin:0;line-height:1.02;letter-spacing:-.01em}
  .hero-copy h1 em{font-style:italic;color:var(--blue-ink)}
  .hero-copy p{color:var(--muted);font-size:14px;margin:12px 0 0;max-width:320px}
  .legend{position:absolute;left:6px;bottom:10px;display:flex;gap:14px;flex-wrap:wrap;z-index:3;font-size:12px;color:var(--muted)}
  .legend .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:middle;box-shadow:0 0 10px currentColor}
  .filters{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0 4px}
  .chip{
    appearance:none;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--muted);
    border-radius:999px;padding:9px 15px;font:600 13px Inter;cursor:pointer;transition:.16s
  }
  .chip:hover{color:var(--ink);border-color:rgba(255,255,255,.22)}
  .chip[aria-pressed="true"]{background:var(--ink);color:#0a0e14;border-color:var(--ink)}
  .chip:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}
  .tip{
    position:absolute;z-index:5;pointer-events:none;transform:translate(-50%,-140%);
    background:var(--glass-strong);border:1px solid var(--line);border-radius:10px;
    padding:7px 11px;font-size:12px;font-weight:600;white-space:nowrap;opacity:0;transition:opacity .12s;
    box-shadow:0 8px 24px rgba(0,0,0,.5)
  }
  .tip small{display:block;font-weight:500;color:var(--muted);letter-spacing:.02em;margin-top:1px}

  /* Detail panel */
  .scrim{position:fixed;inset:0;background:rgba(2,4,8,.5);backdrop-filter:blur(2px);opacity:0;visibility:hidden;transition:.25s;z-index:50}
  .scrim.open{opacity:1;visibility:visible}
  .panel{
    position:fixed;top:0;right:0;height:100%;width:min(440px,92vw);z-index:60;
    background:var(--glass-strong);backdrop-filter:saturate(160%) blur(24px);-webkit-backdrop-filter:saturate(160%) blur(24px);
    border-left:1px solid var(--line);box-shadow:var(--shadow);
    transform:translateX(102%);transition:transform .32s cubic-bezier(.22,1,.36,1);
    display:flex;flex-direction:column
  }
  .panel.open{transform:none}
  .panel .ph{padding:22px 24px 16px;border-bottom:1px solid var(--line);position:relative}
  .panel .pbody{padding:18px 24px 40px;overflow:auto}
  .x{position:absolute;top:16px;right:16px;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);
    background:rgba(255,255,255,.05);color:var(--ink);font-size:16px;cursor:pointer;display:grid;place-items:center}
  .x:hover{background:rgba(255,255,255,.12)}
  .kicker{font-size:11px;letter-spacing:.28em;color:var(--faint);text-transform:uppercase}
  .pname{font-size:34px;font-weight:600;margin:6px 0 2px;letter-spacing:-.01em;line-height:1.04}
  .psub{color:var(--muted);font-size:13px}
  .badge{display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:7px 14px;font-weight:700;font-size:13px;margin-top:14px;border:1px solid transparent}
  .badge .d{width:8px;height:8px;border-radius:50%;box-shadow:0 0 8px currentColor}
  .b-buy{background:rgba(52,199,89,.14);color:#7ee29a;border-color:rgba(52,199,89,.4)}
  .b-hold{background:rgba(90,200,250,.14);color:#9ee0ff;border-color:rgba(90,200,250,.4)}
  .b-watch{background:rgba(255,179,64,.14);color:#ffd08a;border-color:rgba(255,179,64,.4)}
  .b-avoid{background:rgba(255,107,94,.14);color:#ff9d94;border-color:rgba(255,107,94,.4)}
  .row{padding:15px 0;border-bottom:1px solid var(--line)}
  .row:last-child{border-bottom:0}
  .row h4{margin:0 0 7px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--faint);font-weight:700}
  .row p{margin:0;font-size:14.5px;line-height:1.55;color:#d6dde8}
  .tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:2px}
  .tag{font-size:12.5px;border:1px solid var(--line);border-radius:8px;padding:5px 10px;color:#cdd6e3;background:rgba(255,255,255,.03)}
  .tag.serif{font-size:15px}
  .vy{display:flex;flex-wrap:wrap;gap:6px}
  .vy span{font:600 13px Inter;background:rgba(10,132,255,.12);border:1px solid rgba(10,132,255,.3);color:var(--blue-ink);border-radius:8px;padding:4px 9px}
  .stark-read{background:rgba(122,31,43,.16);border:1px solid rgba(122,31,43,.45);border-radius:12px;padding:13px 15px;margin-top:4px}
  .stark-read h4{color:#e9b5bd}
  .stark-read p{color:#f1d9dd}

  /* ---------- LIBRARY ---------- */
  .search{position:relative;margin:22px 0 8px}
  .search input{
    width:100%;background:var(--glass);border:1px solid var(--line);border-radius:14px;
    color:var(--ink);font:500 16px Inter;padding:15px 16px 15px 46px
  }
  .search input::placeholder{color:var(--faint)}
  .search input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 4px rgba(10,132,255,.18)}
  .search svg{position:absolute;left:15px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--faint)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:14px;margin-top:14px}
  .card{
    background:var(--glass);border:1px solid var(--line);border-radius:var(--radius);padding:18px;cursor:pointer;
    transition:.18s;position:relative;overflow:hidden
  }
  .card:hover{transform:translateY(-3px);border-color:rgba(255,255,255,.2);box-shadow:0 18px 40px rgba(0,0,0,.4)}
  .card:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}
  .card .top{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .card .flag{font-size:24px}
  .card .sig{font-size:11px;font-weight:700;letter-spacing:.06em;padding:4px 9px;border-radius:999px}
  .card h3{font-family:"Cormorant Garamond",serif;font-weight:600;font-size:26px;margin:12px 0 2px;line-height:1.02}
  .card .meta{color:var(--muted);font-size:12.5px}
  .card .soil{margin-top:11px;font-size:13px;color:#cbd4e0;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .card .strip{position:absolute;left:0;top:0;bottom:0;width:4px}

  .section-h{display:flex;align-items:baseline;gap:12px;margin:38px 0 4px}
  .section-h h2{font-family:"Cormorant Garamond",serif;font-weight:600;font-size:30px;margin:0}
  .section-h span{font-size:12px;color:var(--faint);letter-spacing:.04em}
  .gloss{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:14px}
  .gl{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:var(--radius-sm);padding:14px 16px}
  .gl dt{font-weight:700;font-size:14px;color:var(--ink)}
  .gl dd{margin:5px 0 0;font-size:13px;color:var(--muted);line-height:1.5}

  /* ---------- SIGNALS ---------- */
  .lede{color:var(--muted);font-size:15px;max-width:660px;margin:22px 0 4px;line-height:1.6}
  .asof{font-size:12px;color:var(--faint);margin-top:6px}
  .sigwrap{margin-top:26px}
  .siggroup{margin-top:22px}
  .siggroup > .gh{display:flex;align-items:center;gap:10px;margin-bottom:10px}
  .gh .dot{width:11px;height:11px;border-radius:50%;box-shadow:0 0 10px currentColor}
  .gh h3{margin:0;font-size:15px;font-weight:700;letter-spacing:.02em}
  .gh em{font-style:normal;color:var(--faint);font-size:12.5px;margin-left:auto}
  .sigcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
  .sc{background:var(--glass);border:1px solid var(--line);border-radius:var(--radius-sm);padding:15px 17px;cursor:pointer;transition:.16s}
  .sc:hover{border-color:rgba(255,255,255,.2);transform:translateY(-2px)}
  .sc .scn{display:flex;align-items:center;gap:9px}
  .sc .scn b{font-family:"Cormorant Garamond",serif;font-size:21px;font-weight:600}
  .sc .scn small{color:var(--faint);font-size:12px;margin-left:auto}
  .sc p{margin:9px 0 0;font-size:13.5px;color:#cdd6e3;line-height:1.5}

  .demand{margin-top:14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
  .dm{background:linear-gradient(180deg,rgba(10,132,255,.07),rgba(255,255,255,.02));border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px 18px}
  .dm .h{display:flex;align-items:center;gap:10px}
  .dm .h b{font-size:15px}
  .dm .h .arr{margin-left:auto;font-weight:700;font-size:13px}
  .up{color:var(--buy)} .down{color:var(--avoid)} .flat{color:var(--watch)}
  .dm p{margin:9px 0 0;font-size:13.5px;color:#cbd4e0;line-height:1.55}

  footer{max-width:var(--maxw);margin:40px auto 0;padding:24px 20px;border-top:1px solid var(--line);color:var(--faint);font-size:12.5px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}
  footer b{color:var(--muted)}
  .anchor{letter-spacing:.22em;color:var(--bordeaux);font-weight:700}

  @media (max-width:620px){
    .hero-copy h1{font-size:34px}
    .stage{height:64vh}
    .seg{width:100%;justify-content:center;margin-left:0}
    .bar{gap:12px}
  }
  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
  }
</style>
</head>
<body>
<header>
  <div class="bar">
    <div class="brand">
      <div class="t">STARK · <b>ВИНО &amp; СПИРТЫ</b></div>
      <div class="s">I AM IRON MAN</div>
    </div>
