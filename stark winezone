      </div>
      <div class="legend">
        <span><i class="dot" style="color:var(--buy)"></i>Накопление</span>
        <span><i class="dot" style="color:var(--hold)"></i>Держать</span>
        <span><i class="dot" style="color:var(--watch)"></i>Наблюдать</span>
        <span><i class="dot" style="color:var(--avoid)"></i>Избегать</span>
      </div>
      <div class="tip" id="tip"></div>
    </div>
    <div class="filters" id="filters" role="group" aria-label="Фильтр по категории"></div>
  </section>

  <!-- LIBRARY -->
  <section id="library-view" class="view" role="tabpanel">
    <div class="search">
