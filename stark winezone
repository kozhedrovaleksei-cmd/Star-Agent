let scene, camera, renderer, raycaster, globeGroup, pinGroup, pins=[];
let dragging=false, moved=0, lastX=0, lastY=0, autoRot=true, hovered=null;
const canvas = document.getElementById('globe');
const tip = document.getElementById('tip');
const stage = document.querySelector('.stage');
let activeFilter = 'all';

function latLngToVec3(lat,lng,r){
  const phi=(90-lat)*Math.PI/180, theta=(lng+180)*Math.PI/180;
  return new THREE.Vector3(
    -r*Math.sin(phi)*Math.cos(theta),
     r*Math.cos(phi),
     r*Math.sin(phi)*Math.sin(theta)
  );
}

function initGlobe(){
  if(typeof THREE==='undefined'){ canvas.style.display='none'; return; }
  scene=new THREE.Scene();
  const w=stage.clientWidth, h=stage.clientHeight;
  camera=new THREE.PerspectiveCamera(42,w/h,0.1,100);
  camera.position.z=3.05;
  renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
  renderer.setSize(w,h); renderer.setPixelRatio(Math.min(devicePixelRatio,2));

  globeGroup=new THREE.Group(); scene.add(globeGroup);

  // sphere
  const geo=new THREE.SphereGeometry(1,64,64);
  const mat=new THREE.MeshPhongMaterial({color:0x10202f,emissive:0x05111c,specular:0x113355,shininess:12});
  const sphere=new THREE.Mesh(geo,mat); globeGroup.add(sphere);

  // try texture, keep fallback on error
  new THREE.TextureLoader().load(
    'https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/textures/planets/earth_atmos_2048.jpg',
    (tex)=>{ mat.map=tex; mat.color.set(0xffffff); mat.emissive.set(0x0a1622); mat.needsUpdate=true; },
    undefined, ()=>{}
  );

  // atmosphere
  const atm=new THREE.Mesh(
    new THREE.SphereGeometry(1.16,64,64),
    new THREE.ShaderMaterial({
      transparent:true, side:THREE.BackSide, blending:THREE.AdditiveBlending,
      vertexShader:'varying vec3 n; void main(){ n=normalize(normalMatrix*normal); gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
      fragmentShader:'varying vec3 n; void main(){ float i=pow(.62-dot(n,vec3(0,0,1.0)),3.0); gl_FragColor=vec4(.10,.45,1.0,1.0)*i; }'
    })
  );
  scene.add(atm);

  // wireframe overlay for terminal feel
  const wire=new THREE.Mesh(new THREE.SphereGeometry(1.003,36,24),
    new THREE.MeshBasicMaterial({color:0x2a4866,wireframe:true,transparent:true,opacity:.16}));
  globeGroup.add(wire);

  // lights
  scene.add(new THREE.AmbientLight(0x88aacc,.65));
  const key=new THREE.DirectionalLight(0xffffff,1.1); key.position.set(3,2,4); scene.add(key);
  const rim=new THREE.DirectionalLight(0x7a1f2b,.5); rim.position.set(-4,-1,-3); scene.add(rim);

  // stars
  const sg=new THREE.BufferGeometry(); const N=900, arr=new Float32Array(N*3);
  for(let i=0;i<N;i++){ const r=18+Math.random()*22, t=Math.random()*Math.PI*2, p=Math.acos(2*Math.random()-1);
    arr[i*3]=r*Math.sin(p)*Math.cos(t); arr[i*3+1]=r*Math.sin(p)*Math.sin(t); arr[i*3+2]=r*Math.cos(p); }
  sg.setAttribute('position',new THREE.BufferAttribute(arr,3));
  scene.add(new THREE.Points(sg,new THREE.PointsMaterial({color:0x9fb6d6,size:.06,transparent:true,opacity:.55})));

  // pins
  pinGroup=new THREE.Group(); globeGroup.add(pinGroup);
  buildPins();

  raycaster=new THREE.Raycaster();
  bindControls();
  animate();
  window.addEventListener('resize',onResize);
}

function buildPins(){
  while(pinGroup.children.length) pinGroup.remove(pinGroup.children[0]);
  pins=[];
  DATA.forEach(d=>{
    if(activeFilter!=='all' && d.cat!==activeFilter) return;
    const pos=latLngToVec3(d.lat,d.lng,1.02);
    const hex=SIG[d.sig].hex;
    const m=new THREE.Mesh(new THREE.SphereGeometry(0.018,16,16),
      new THREE.MeshBasicMaterial({color:hex}));
    m.position.copy(pos); m.userData=d;
    const halo=new THREE.Sprite(new THREE.SpriteMaterial({
      map:haloTex(hex), color:0xffffff, transparent:true, blending:THREE.AdditiveBlending, depthWrite:false
    }));
    halo.scale.set(.12,.12,.12); halo.position.copy(pos);
    pinGroup.add(halo); pinGroup.add(m);
    pins.push(m);
  });
}
const haloCache={};
function haloTex(hex){
  if(haloCache[hex]) return haloCache[hex];
  const c=document.createElement('canvas'); c.width=c.height=64; const g=c.getContext('2d');
  const col='#'+hex.toString(16).padStart(6,'0');
  const grd=g.createRadialGradient(32,32,0,32,32,32);
  grd.addColorStop(0,col); grd.addColorStop(.35,col+'aa'); grd.addColorStop(1,col+'00');
  g.fillStyle=grd; g.fillRect(0,0,64,64);
  const t=new THREE.CanvasTexture(c); haloCache[hex]=t; return t;
}

function bindControls(){
  const down=e=>{dragging=true;moved=0;autoRot=false;canvas.classList.add('grabbing');
    const p=pt(e); lastX=p.x; lastY=p.y;};
  const move=e=>{
    const p=pt(e);
    if(dragging){
      const dx=p.x-lastX, dy=p.y-lastY; moved+=Math.abs(dx)+Math.abs(dy);
      globeGroup.rotation.y+=dx*0.005;
      globeGroup.rotation.x=Math.max(-1.2,Math.min(1.2,globeGroup.rotation.x+dy*0.005));
      lastX=p.x; lastY=p.y;
    } else { hover(p); }
  };
  const up=e=>{
    canvas.classList.remove('grabbing');
    if(dragging && moved<6){ const p=pt(e); pick(p); }
    dragging=false; setTimeout(()=>autoRot=true,2500);
  };
  canvas.addEventListener('pointerdown',down);
  window.addEventListener('pointermove',move);
  window.addEventListener('pointerup',up);
  canvas.addEventListener('wheel',e=>{e.preventDefault();
    camera.position.z=Math.max(1.9,Math.min(5,camera.position.z+e.deltaY*0.0016));},{passive:false});
}
function pt(e){const r=canvas.getBoundingClientRect();
  return {x:e.clientX-r.left,y:e.clientY-r.top, nx:((e.clientX-r.left)/r.width)*2-1, ny:-((e.clientY-r.top)/r.height)*2+1};}

function castHit(p){
  raycaster.setFromCamera({x:p.nx,y:p.ny},camera);
  return raycaster.intersectObjects(pins,false)[0];
}
function hover(p){
  const hit=castHit(p);
  if(hit){
    canvas.style.cursor='pointer';
    const d=hit.object.userData;
    tip.innerHTML=d.ru+' <small>'+SIG[d.sig].label+' · '+d.country+'</small>';
    tip.style.left=p.x+'px'; tip.style.top=p.y+'px'; tip.style.opacity='1';
    hovered=d;
  } else {
    canvas.style.cursor='grab'; tip.style.opacity='0'; hovered=null;
  }
}
function pick(p){ const hit=castHit(p); if(hit) openPanel(hit.object.userData); }

function onResize(){
  const w=stage.clientWidth,h=stage.clientHeight;
  camera.aspect=w/h; camera.updateProjectionMatrix(); renderer.setSize(w,h);
}
function animate(){
  requestAnimationFrame(animate);
  if(autoRot && !dragging) globeGroup.rotation.y+=0.0011;
  renderer.render(scene,camera);
}

/* ============================== PANEL ============================== */
const panel=document.getElementById('panel'), scrim=document.getElementById('scrim');
function openPanel(d){
  const s=SIG[d.sig];
  panel.innerHTML=`
    <div class="ph">
      <button class="x" aria-label="Закрыть" onclick="closePanel()">✕</button>
      <div class="kicker">${d.flag} ${d.country} · ${d.type}</div>
      <div class="pname serif">${d.name}</div>
      <div class="psub">${d.ru}</div>
      <span class="badge ${s.cls}"><span class="d" style="color:${s.color};background:currentColor"></span>${s.label}</span>
    </div>
    <div class="pbody">
      <div class="row stark-read">
        <h4>Сигнал STARK</h4><p>${d.read}</p>
      </div>
      <div class="row"><h4>Почвы · терруар</h4><p>${d.soil}</p></div>
      <div class="row"><h4>Сорт / основа</h4><div class="tags"><span class="tag">${d.grape}</span></div></div>
      <div class="row"><h4>Что искать · хозяйства</h4>
        <div class="tags">${d.producers.map(p=>`<span class="tag serif">${p}</span>`).join('')}</div></div>
      <div class="row"><h4>Великие винтажи / релизы</h4>
        <div class="vy">${d.vintages.map(v=>`<span>${v}</span>`).join('')}</div></div>
      <div class="row"><h4>Где спрос</h4><p>${d.demand}</p></div>
    </div>`;
  panel.classList.add('open'); panel.setAttribute('aria-hidden','false');
  scrim.classList.add('open');
}
function closePanel(){ panel.classList.remove('open'); panel.setAttribute('aria-hidden','true'); scrim.classList.remove('open'); }
scrim.addEventListener('click',closePanel);
document.addEventListener('keydown',e=>{ if(e.key==='Escape') closePanel(); });

/* ============================== FILTERS ============================== */
const CATS=[['all','Всё'],['wine','🍷 Вино'],['whisky','🥃 Виски'],['agave','🌵 Текила·Агава'],['cognac','🍇 Коньяк'],['rum','🥃 Ром']];
const fEl=document.getElementById('filters');
CATS.forEach(([k,label])=>{
  const b=document.createElement('button');
  b.className='chip'; b.textContent=label; b.setAttribute('aria-pressed', k==='all');
  b.onclick=()=>{ activeFilter=k;
    [...fEl.children].forEach(c=>c.setAttribute('aria-pressed','false'));
    b.setAttribute('aria-pressed','true');
    if(renderer) buildPins(); renderCards(document.getElementById('q').value);
  };
  fEl.appendChild(b);
});

/* ============================== LIBRARY ============================== */
const cardsEl=document.getElementById('cards');
function sigPill(sig){const s=SIG[sig];
  return `<span class="sig" style="background:${s.color}22;color:${s.color}">${s.label}</span>`;}
function renderCards(query=''){
  const q=query.trim().toLowerCase();
  cardsEl.innerHTML='';
  DATA.filter(d=>{
    if(activeFilter!=='all' && d.cat!==activeFilter) return false;
    if(!q) return true;
    const hay=(d.name+' '+d.ru+' '+d.country+' '+d.grape+' '+d.soil+' '+d.producers.join(' ')+' '+d.type).toLowerCase();
    return hay.includes(q);
  }).forEach(d=>{
    const s=SIG[d.sig];
    const el=document.createElement('div');
    el.className='card'; el.tabIndex=0; el.setAttribute('role','button');
    el.innerHTML=`
      <span class="strip" style="background:${s.color}"></span>
      <div class="top"><span class="flag">${d.flag}</span>${sigPill(d.sig)}</div>
      <h3>${d.name}</h3>
      <div class="meta">${d.ru} · ${d.country} · ${d.type}</div>
      <div class="soil">${d.soil}</div>`;
    el.onclick=()=>openPanel(d);
    el.onkeydown=e=>{ if(e.key==='Enter'||e.key===' '){e.preventDefault();openPanel(d);} };
    cardsEl.appendChild(el);
  });
  if(!cardsEl.children.length){
    cardsEl.innerHTML='<p style="color:var(--muted)">Ничего не найдено. Попробуй «сланец», «Brunello», «торф» или сними фильтр.</p>';
  }
}
document.getElementById('q').addEventListener('input',e=>renderCards(e.target.value));

const glEl=document.getElementById('gloss');
GLOSSARY.forEach(([t,d])=>{ const w=document.createElement('div'); w.className='gl';
  w.innerHTML=`<dt>${t}</dt><dd>${d}</dd>`; glEl.appendChild(w); });

/* ============================== SIGNALS BOARD ============================== */
const board=document.getElementById('sigboard');
['buy','hold','watch','avoid'].forEach(key=>{
  const items=DATA.filter(d=>d.sig===key);
  if(!items.length) return;
  const s=SIG[key];
  const g=document.createElement('div'); g.className='siggroup';
  g.innerHTML=`<div class="gh"><span class="dot" style="color:${s.color}"></span>
    <h3>${s.label}</h3><em>${items.length} регион(ов)</em></div>`;
  const wrap=document.createElement('div'); wrap.className='sigcards';
  items.forEach(d=>{
    const c=document.createElement('div'); c.className='sc';
    c.innerHTML=`<div class="scn"><span>${d.flag}</span><b>${d.name}</b><small>${d.type.split('·')[0].trim()}</small></div>
      <p>${d.read}</p>`;
    c.onclick=()=>openPanel(d);
    wrap.appendChild(c);
  });
  g.appendChild(wrap); board.appendChild(g);
});

const demEl=document.getElementById('demand');
DEMAND.forEach(x=>{ const el=document.createElement('div'); el.className='dm';
  el.innerHTML=`<div class="h"><span>${x.flag}</span><b>${x.name}</b><span class="arr ${x.dir}">${x.arr}</span></div><p>${x.txt}</p>`;
  demEl.appendChild(el); });

/* ============================== VIEW SWITCH ============================== */
document.querySelectorAll('.seg button').forEach(btn=>{
  btn.onclick=()=>{
    document.querySelectorAll('.seg button').forEach(b=>b.setAttribute('aria-selected','false'));
    btn.setAttribute('aria-selected','true');
    const v=btn.dataset.view;
    document.querySelectorAll('.view').forEach(s=>s.classList.remove('active'));
    document.getElementById(v+'-view').classList.add('active');
    if(v==='globe' && renderer) onResize();
  };
});

/* ============================== BOOT ============================== */
renderCards('');
initGlobe();
</script>
</body>
